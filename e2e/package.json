{
  "name": "@wafflefinance/e2e",
  "version": "1.0.0",
  "description": "Cross-chain differential test harness (EVM HTLCEscrow ↔ Soroban wafflefinance-htlc). Verifies the sha256 hashlock and preimage semantics round-trip across both chain clients using the shared @wafflefinance/sdk secret helpers.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:health": "vitest run --config health/vitest.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@wafflefinance/sdk": "workspace:*",
    "@stellar/stellar-sdk": "^13.3.0",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.3",
    "express": "^4.18.2",
    "supertest": "^7.2.2",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0"
  }
}
